# Copy to .env (or set these in Coolify's UI) before deploying.

# Password you'll type on the login screen.
APP_PASSWORD=change-me-to-something-strong

# Secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-hex-string

# The family's timezone. Build-time, inlined by Next — setting it in the runtime env has NO effect.
# Used for "Recorded" timestamps and, since v13, to convert absolute times in a subscribed iCal feed
# into the wall-clock Kin stores. It therefore decides recorded event DATA, not just display, and
# changing it does not retroactively fix already-imported events. See docs/ical-subscriptions.md.
NEXT_PUBLIC_TZ=America/New_York

# Optional — AI natural-language quick-add via a LiteLLM (OpenAI-compatible) endpoint.
# Leave unset to disable the quick-add feature.
LITELLM_BASE_URL=https://your-litellm-host
LITELLM_API_KEY=your-litellm-virtual-key
LITELLM_MODEL=your-model-alias

# Optional LEGACY fallback for MCP agent access — prefer minting revocable per-agent tokens
# in-app (⚙ Settings → Agent access). With no env token and no minted token, MCP returns 503.
# Generate a high-entropy value (>= 24 chars):  openssl rand -hex 24
KIN_MCP_TOKEN=

# Litestream → Cloudflare R2 (set in Coolify env, not committed)
R2_BUCKET=kin-backups
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
